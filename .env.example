# Configuracion de la aplicacion (ver src/retail_scraping_lab/config/settings.py)

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
RSL_LOG_LEVEL=INFO

# Cliente HTTP
RSL_HTTP_TIMEOUT_SECONDS=10
RSL_HTTP_USER_AGENT="retail-scraping-lab/0.1 (+https://github.com/<usuario>/retail-scraping-lab)"

# Base de datos (SQLite por defecto, ver docs/adr/0003-use-sqlite-first.md)
RSL_DATABASE_URL="sqlite:///./data/processed/retail_scraping_lab.db"

# Rutas de datos
RSL_DATA_RAW_DIR=data/raw
RSL_DATA_PROCESSED_DIR=data/processed
RSL_DATA_EXPORTS_DIR=data/exports
